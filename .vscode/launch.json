  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Attach to Device",
      "type": "dart",
      "request": "attach"
    },
    {
      "name": "Debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "web",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "args": [
          "--web-port=5000",
          "--web-enable-expression-evaluation"
      ],
    },
  ]
}
