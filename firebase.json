{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "soguifleet-manager",
          "appId": "1:112122756366:android:7435859e80e316373fab5f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "soguifleet-manager",
          "appId": "1:112122756366:ios:4dc1c03248a823d93fab5f",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "soguifleet-manager",
          "appId": "1:112122756366:ios:4dc1c03248a823d93fab5f",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "soguifleet-manager",
          "configurations": {
            "android": "1:112122756366:android:7435859e80e316373fab5f",
            "ios": "1:112122756366:ios:4dc1c03248a823d93fab5f",
            "macos": "1:112122756366:ios:4dc1c03248a823d93fab5f",
            "web": "1:112122756366:web:b97ef049045294353fab5f",
            "windows": "1:112122756366:web:414aca1b2d1b87b73fab5f"
          }
        }
      }
    }
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
